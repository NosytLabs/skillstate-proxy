{
  "name": "skillstate-proxy",
  "version": "0.1.0",
  "description": "Drop-in token-savings proxy for long-horizon LLM agents. Cuts prompt tokens 60-95% via SKILL.state structured state (arXiv:2608.26263, EMNLP 2026). Model-agnostic: works with OpenAI, Anthropic, Venice, OpenRouter, vLLM, Ollama, any OpenAI-compatible upstream.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skillstate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./state": "./dist/state.js",
    "./proxy": "./dist/proxy.js",
    "./anthropic": "./dist/anthropic.js",
    "./pricing": "./dist/pricing.js",
    "./cost-ledger": "./dist/cost-ledger.js",
    "./circuit-breaker": "./dist/circuit-breaker.js",
    "./rate-limiter": "./dist/rate-limiter.js",
    "./token-estimate": "./dist/token-estimate.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },

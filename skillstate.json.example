{
  "listenPort": 8789,
  "upstreams": [
    {
      "name": "openai",
      "url": "https://api.openai.com/v1",
      "apiKey": "YOUR_UPSTREAM_API_KEY",
      "priority": 0
    },
    {
      "name": "openrouter",
      "url": "https://openrouter.ai/api/v1",
      "apiKey": "YOUR_SECOND_UPSTREAM_API_KEY",
      "priority": 1
    }
  ],
  "stateDir": "~/.skillstate/state",
  "schema": ["step", "notes", "flags"],
  "initialState": {
    "step": 0,
    "notes": [],
    "flags": []
  },
  "maxRetries": 2,
  "maxBodyBytes": 1048576,
  "maxPatchBytes": 32768,
  "maxStateBytes": 65536,
  "maxResponseCaptureBytes": 2097152,
  "sessionTtlMs": 86400000,
  "connectTimeoutMs": 10000,
  "requestTimeoutMs": 300000,
  "retryMaxAttempts": 3,
  "retryAfterCapMs": 5000,
  "cors": true,
  "costLedgerPath": "~/.skillstate/spend.jsonl"
}
